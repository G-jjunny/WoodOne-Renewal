# ============================================================
# 우드원 환경변수 예시 파일
# 이 파일을 .env.local로 복사한 후 실제 값으로 교체하세요.
# .env.local은 .gitignore에 추가되어 있어야 합니다.
# ============================================================

# 카카오맵 API 키 (https://developers.kakao.com)
NEXT_PUBLIC_KAKAO_MAP_KEY=your_kakao_map_javascript_key_here

# 문의 이메일 SMTP 설정 (nodemailer)
# Gmail 사용 시: Google 계정 > 보안 > 앱 비밀번호 생성
CONTACT_SMTP_HOST=smtp.gmail.com
CONTACT_SMTP_PORT=587
CONTACT_SMTP_USER=your_email@gmail.com
CONTACT_SMTP_PASS=your_app_password_here

# 문의 이메일 수신 주소 (우드원 담당자 이메일)
CONTACT_TO_EMAIL=info@woodone.co.kr
